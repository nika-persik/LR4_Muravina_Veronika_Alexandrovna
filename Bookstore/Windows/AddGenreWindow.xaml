<Window x:Class="Bookstore.Windows.AddGenreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bookstore.Windows"
        mc:Ignorable="d"
        Title="Добавление жанра" Height="320" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="#F5F5F5" Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Добавление жанра" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 15"/>

            <TextBlock Text="Название жанра:*"/>
            <TextBox x:Name="TboxGenreName" Height="28" Margin="0 0 0 10" VerticalContentAlignment="Center"/>

            <TextBlock Text="Описание жанра:"/>
            <TextBox x:Name="TboxDescription" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0 0 0 15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Сохранить" Click="BtnSave_Click" Width="120" Height="30" Margin="0 0 10 0" Background="#57aeff"/>
                <Button Content="Отмена" Click="BtnCancel_Click" Width="120" Height="30" Background="Transparent" BorderThickness="1"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
