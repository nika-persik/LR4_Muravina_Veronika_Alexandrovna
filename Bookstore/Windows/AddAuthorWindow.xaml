<Window x:Class="Bookstore.Windows.AddAuthorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bookstore.Windows"
        mc:Ignorable="d"
        Title="Добавление автора" Height="300" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="#F5F5F5" Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Добавление автора" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 15"/>

                <TextBlock Text="Фамилия:*"/>
                <TextBox x:Name="TboxSurname" Height="28" Margin="0 0 0 10" VerticalContentAlignment="Center"/>

                <TextBlock Text="Имя:*"/>
                <TextBox x:Name="TboxName" Height="28" Margin="0 0 0 10" VerticalContentAlignment="Center"/>

                <TextBlock Text="Отчество:"/>
                <TextBox x:Name="TboxPatronymic" Height="28" Margin="0 0 0 10" VerticalContentAlignment="Center"/>

                <TextBlock Text="Дата рождения:"/>
                <DatePicker x:Name="DpDateOfBirth" Height="28" Margin="0 0 0 10"/>

                <TextBlock Text="Дата смерти (если применимо):"/>
                <DatePicker x:Name="DpDateOfDeath" Height="28" Margin="0 0 0 10"/>

                <TextBlock Text="Биография:"/>
                <TextBox x:Name="TboxBiography" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0 0 0 15"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Сохранить" Click="BtnSave_Click" Width="120" Height="30" Margin="0 0 10 0" Background="#57aeff"/>
                    <Button Content="Отмена" Click="BtnCancel_Click" Width="120" Height="30" Background="Transparent" BorderThickness="1"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
