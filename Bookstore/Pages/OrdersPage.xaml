<Page x:Class="Bookstore.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Bookstore.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Заказы клиентов"
      Loaded="Page_Loaded">

    <Grid Background="#F9F9F9" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Все заказы" FontSize="18" FontWeight="Bold" Margin="0 0 0 10"/>

        <DataGrid x:Name="OrdersDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="OrdersDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ Заказа" Binding="{Binding ID_order}" Width="1*"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Users.Login}" Width="2*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Order_date, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="2*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="1.5*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 10 0 10">
            <TextBlock Text="Новый статус: " VerticalAlignment="Center" Margin="0 0 10 0"/>
            <ComboBox x:Name="ComboStatus" Width="150" Height="28">
                <ComboBoxItem Content="Новый"/>
                <ComboBoxItem Content="В обработке"/>
                <ComboBoxItem Content="Готов к выдаче"/>
                <ComboBoxItem Content="Доставлен"/>
                <ComboBoxItem Content="Отменен"/>
            </ComboBox>
            <Button Content="Изменить статус" Click="BtnUpdateStatus_Click" Height="28" Width="130" Margin="10 0 0 0" Background="#73d990"/>
        </StackPanel>

        <DataGrid x:Name="OrderItemsDataGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Книга" Binding="{Binding Books.Name}" Width="3*"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="1*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Unit_price}" Width="1*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="4" Content="Назад к каталогу" Click="BtnBack_Click" Width="150" Height="30" HorizontalAlignment="Left" Margin="0 10 0 0" Background="#57aeff"/>
    </Grid>
</Page>
