<Page x:Class="Bookstore.Pages.AddBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Bookstore.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавление книги">

    <Grid Background="#F5F5F5">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
            <TextBlock x:Name="HeaderTextBlock" Text="Добавление книги" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 20"/>

            <TextBlock Text="Название книги:*"/>
            <TextBox x:Name="TboxTitle" Height="28" Margin="0 0 0 10" VerticalContentAlignment="Center"/>

            <TextBlock Text="Автор:*"/>
            <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                <ComboBox x:Name="ComboAuthor" Width="265" Height="28"/>
                <Button Content="+" x:Name="BtnAddAuthor" Click="BtnAddAuthor_Click" Width="35" Height="28" Margin="10 0 0 0" FontWeight="Bold" FontSize="16"/>
            </StackPanel>

            <TextBlock Text="Жанр:*"/>
            <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                <ComboBox x:Name="ComboGenre" Width="265" Height="28"/>
                <Button Content="+" x:Name="BtnAddGenre" Click="BtnAddGenre_Click" Width="35" Height="28" Margin="10 0 0 0" FontWeight="Bold" FontSize="16"/>
            </StackPanel>

            <TextBlock Text="Год издания:*"/>
            <TextBox x:Name="TboxYear" Height="28" Margin="0 0 0 10" VerticalContentAlignment="Center"/>

            <TextBlock Text="Цена (руб.):*"/>
            <TextBox x:Name="TboxPrice" Height="28" Margin="0 0 0 10" VerticalContentAlignment="Center"/>

            <TextBlock Text="Количество на складе:*"/>
            <TextBox x:Name="TboxStock" Height="28" Margin="0 0 0 20" VerticalContentAlignment="Center"/>

            <Button Content="Сохранить" Click="BtnSave_Click" Height="35" Margin="0 0 0 5" Background="#57aeff"/>
            <Button Content="Отмена" Click="BtnCancel_Click" Height="28" Background="Transparent" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Page>
