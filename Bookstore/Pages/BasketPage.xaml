<Page x:Class="Bookstore.Pages.BasketPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Bookstore.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Корзина"
      Loaded="Page_Loaded">

    <Grid Background="#F9F9F9" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Ваша корзина" FontSize="22" FontWeight="Bold" Margin="0 0 0 15"/>

        <DataGrid x:Name="BasketDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название книги" Binding="{Binding BookName}" Width="3*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="1*"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="1*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Summa}" Width="1*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0 15 0 0">
            <TextBlock x:Name="TotalSumTextBlock" Text="Итого: 0 руб." FontSize="18" FontWeight="Bold" Margin="0 0 0 10"/>
            <Button Content="Оформить заказ" Click="BtnCheckout_Click" Height="35" Width="180" Background="#28A745" Foreground="White" FontWeight="Bold"/>
            <Button Content="Назад к каталогу" Click="BtnBack_Click" Height="28" Width="180" Margin="0 5 0 0" Background="Transparent" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Page>
