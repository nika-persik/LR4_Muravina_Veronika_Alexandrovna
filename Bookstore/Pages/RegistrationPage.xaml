<Page x:Class="Bookstore.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Bookstore.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="Регистрация">

    <Grid Background="#F5F5F5">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <TextBlock Text="Регистрация" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 15"/>

                <StackPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                    <TextBlock Text="Фамилия: " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox x:Name="TBoxSurname" Width="200" Height="28" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                    <TextBlock Text="Имя: " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox x:Name="TBoxName" Width="200" Height="28" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                    <TextBlock Text="Отчество: " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox x:Name="TBoxPatronymic" Width="200" Height="28" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                    <TextBlock Text="Email: " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox x:Name="TBoxEmail" Width="200" Height="28" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                    <TextBlock Text="Телефон: " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox x:Name="TBoxPhone" Width="200" Height="28" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                    <TextBlock Text="Логин: " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox x:Name="TBoxRegLog" Width="200" Height="28" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                    <TextBlock Text="Пароль: " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox x:Name="TBoxRegPas" Width="200" Height="28" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="0 10 0 15" HorizontalAlignment="Center">
                    <TextBlock Text="Капча:" FontSize="16" HorizontalAlignment="Center"/>
                    <Border BorderBrush="Gray" BorderThickness="1" Background="#E0E0E0" Width="150" Height="30" Margin="0 5 0 5">
                        <TextBlock x:Name="CaptchaTextBlock" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="CaptchaInputBox" Width="110" Height="25" FontSize="14"/>
                        <Button x:Name="RefreshCaptchaBtn" Content="↻" Width="35" Height="25" Click="RefreshCaptchaBtn_Click" Margin="5 0 0 0"/>
                    </StackPanel>
                </StackPanel>

                <Button Content="Зарегистрироваться" Name="BtnReg" Click="BtnReg_Click" Height="35" Width="200" FontSize="16" Margin="0 0 0 10" Background="#57aeff"/>
                <Button Content="Назад ко входу" Click="BackButton_Click" Height="28" Width="200" Background="Transparent" BorderThickness="0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
