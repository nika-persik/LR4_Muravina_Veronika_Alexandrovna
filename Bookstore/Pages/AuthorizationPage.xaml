<Page x:Class="Bookstore.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Bookstore.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация">

    <Grid Background="#F5F5F5">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Онлайн-магазин книг" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 20"/>

            <StackPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                <TextBlock Text="Логин: " FontSize="16" VerticalAlignment="Center"/>
                <TextBox x:Name="TBoxLogin" Width="200" Height="30" FontSize="16" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" Margin="0 0 0 15">
                <TextBlock Text="Пароль: " FontSize="16" VerticalAlignment="Center"/>
                <PasswordBox x:Name="TBoxPassword" Width="200" Height="30" FontSize="16" VerticalContentAlignment="Center"/>
            </StackPanel>

            <Button Content="Войти" Name="BtnLogin" Click="BtnLogin_Click" Height="35" Width="200" FontSize="16" Margin="0 5 0 10" Background="#57aeff"/>
            <Button Content="Зарегистрироваться" Name="BtnRegistr" Click="BtnRegistr_Click" Height="30" Width="200" FontSize="14" Margin="0 0 0 5"/>
            <Button Content="Войти как гость" Name="BtnGuest" Click="BtnGuest_Click" Height="30" Width="200" FontSize="14" Background="Transparent" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Page>
